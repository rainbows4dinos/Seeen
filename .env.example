# Copy to .env.local for local development. Never commit .env.local.
# Values: Supabase dashboard > Project Settings > API Keys (publishable key).
# For local Supabase (npm run db:start), use the URL and publishable key it prints.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
